{
  "wiki": {
    "apiUrl": "https://wiki.openstreetmap.org/w/api.php",
    "pages": [
      {
        "title": "OpenRailwayMap/Tagging_in_France",
        "role": "Scheme",
        "local": "wiki/backup/OpenRailwayMap/Tagging_in_France.wiki"
      },
      {
        "title": "FR:Key:railway:signal:main:states",
        "role": "Domain",
        "local": "wiki/backup/FR/Key/railway-signal-main-states.wiki"
      },
      {
        "title": "FR:Key:railway:signal:distant:states",
        "role": "Domain",
        "local": "wiki/backup/FR/Key/railway-signal-distant-states.wiki"
      }
    ]
  },
  "keyPrefix": "railway:signal:",
  "countryPrefix": "FR",
  "rules": "validator/rules.json",
  "output": "bot/runs",
  "contact": "https://github.com/noeldev/FrenchRailwaySignalling",
  "scope": {
    "railway": "signal"
  },
  "defaultServer": "dev",
  "servers": {
    "dev": {
      "apiUrl": "https://master.apis.dev.openstreetmap.org",
      "webUrl": "https://master.apis.dev.openstreetmap.org",
      "reviewUrl": "",
      "account": "",
      "clientId": "",
      "allowSeeding": true,
      "approvedRulesSha256": "",
      "quietPeriodHours": 0
    },
    "prod": {
      "apiUrl": "https://api.openstreetmap.org",
      "webUrl": "https://www.openstreetmap.org",
      "reviewUrl": "https://osmcha.org/changesets/{id}",
      "account": "",
      "clientId": "",
      "allowSeeding": false,
      "approvedRulesSha256": "",
      "quietPeriodHours": 24
    }
  },
  "overpass": {
    "endpoint": "https://overpass-api.de/api/interpreter",
    "delaySeconds": 10,
    "query": [
      "[out:json][timeout:300];",
      "area[\"ISO3166-2\"=\"{area}\"]->.scope;",
      "node(area.scope)[\"railway\"=\"signal\"];",
      "out meta;"
    ]
  },
  "areas": [
    { "code": "FR-ARA", "name": "Auvergne-Rhône-Alpes" },
    { "code": "FR-BFC", "name": "Bourgogne-Franche-Comté" },
    { "code": "FR-BRE", "name": "Bretagne" },
    { "code": "FR-CVL", "name": "Centre-Val de Loire" },
    { "code": "FR-20R", "name": "Corse" },
    { "code": "FR-GES", "name": "Grand Est" },
    { "code": "FR-HDF", "name": "Hauts-de-France" },
    { "code": "FR-IDF", "name": "Île-de-France" },
    { "code": "FR-NOR", "name": "Normandie" },
    { "code": "FR-NAQ", "name": "Nouvelle-Aquitaine" },
    { "code": "FR-OCC", "name": "Occitanie" },
    { "code": "FR-PDL", "name": "Pays de la Loire" },
    { "code": "FR-PAC", "name": "Provence-Alpes-Côte d'Azur" }
  ],
  "changeset": {
    "fixComment": "Signalisation ferroviaire française : unification du balisage et correction des erreurs de saisie ({area}, lot {batch})",
    "revertComment": "Signalisation ferroviaire française : annulation de modifications automatisées ({area}, lot {batch})",
    "seedComment": "RailwayMapBot test data (sandbox only)",
    "tags": {
      "created_by": "{tool}",
      "bot": "yes",
      "mechanical": "yes",
      "description": "https://wiki.openstreetmap.org/wiki/Automated_edits/RailwayMapBot"
    }
  },
  "policy": {
    "skipSuggestions": true,
    "skipIncomplete": true,
    "fixMistypedValues": true
  },
  "optOut": {
    "users": [],
    "nodes": []
  },
  "limits": {
    "maxEditsPerRun": 200,
    "maxNodesPerChangeset": 500,
    "maxChangesetSpanDegrees": 1.0,
    "nodesPerRequest": 400,
    "delayBetweenChangesetsSeconds": 5,
    "conflictRetries": 2,
    "readRetries": 3,
    "retryDelaySeconds": 5,
    "maxRateLimitWaitSeconds": 120,
    "requestTimeoutSeconds": 120
  }
}
