<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ValidatorGen</RootNamespace>
    <AssemblyName>ValidatorGen</AssemblyName>
    <Product>ValidatorGen</Product>
    <Version>1.2.0</Version>
    <Company>Noël Danjou EI</Company>
    <Authors>Noël Danjou</Authors>
    <Copyright>Copyright © 2026 Noël Danjou</Copyright>
    <Description>Generates the JOSM/Osmose MapCSS validator rules for French railway signalling from the OSM wiki.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\Signalling.Core\Signalling.Core.csproj" />
    <ProjectReference Include="..\libs\Signalling.Rules\Signalling.Rules.csproj" />
    <ProjectReference Include="..\libs\Signalling.Schema\Signalling.Schema.csproj" />
    <ProjectReference Include="..\libs\Signalling.Wiki\Signalling.Wiki.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json" Condition="Exists('appsettings.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
