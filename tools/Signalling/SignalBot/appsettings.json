{
  "output": "bot/runs",
  "contact": "https://github.com/noeldev/FrenchRailwaySignalling",
  "defaultServer": "dev",
  "servers": {
    "dev": {
      "apiUrl": "https://master.apis.dev.openstreetmap.org",
      "webUrl": "https://master.apis.dev.openstreetmap.org",
      "reviewUrl": "",
      "account": "",
      "clientId": "",
      "allowSeeding": true,
      "quietPeriodHours": 0
    },
    "prod": {
      "apiUrl": "https://api.openstreetmap.org",
      "webUrl": "https://www.openstreetmap.org",
      "reviewUrl": "https://osmcha.org/changesets/{id}",
      "account": "",
      "clientId": "",
      "allowSeeding": false,
      "quietPeriodHours": 24
    }
  },
  "overpass": {
    "endpoints": [
      "https://overpass-api.de/api/interpreter"
    ],
    "timeoutSeconds": 600,
    "retries": 3,
    "retryDelaySeconds": 30,
    "delaySeconds": 10,
    "query": [
      "[out:json][timeout:{timeout}];",
      "{area}->.scope;",
      ".scope out tags;",
      "node(area.scope)[\"railway\"=\"signal\"]{mapper};",
      "out meta;"
    ]
  },
  "changeset": {
    "seedComment": "SignalBot test data (sandbox only)",
    "tags": {
      "created_by": "{tool}",
      "bot": "yes",
      "mechanical": "yes",
      "description": "https://github.com/noeldev/FrenchRailwaySignalling"
    }
  },
  "policy": {
    "skipSuggestions": true,
    "skipIncomplete": true,
    "fixMistypedValues": true
  },
  "limits": {
    "maxEditsPerRun": 200,
    "maxNodesPerChangeset": 500,
    "maxChangesetSpanDegrees": 1.0,
    "nodesPerRequest": 400,
    "delayBetweenChangesetsSeconds": 5,
    "conflictRetries": 2,
    "readRetries": 3,
    "retryDelaySeconds": 5,
    "maxRateLimitWaitSeconds": 120,
    "requestTimeoutSeconds": 120
  }
}
