    <Copyright>Copyright (C) 2026 Noël Danjou</Copyright>
    <Description>Documented railway signalling scheme (keys and values) built from the OSM wiki pages, shared by the validator and MapRoulette generators.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Signalling.Core\Signalling.Core.csproj" />
    <ProjectReference Include="..\Signalling.Wiki\Signalling.Wiki.csproj" />
  </ItemGroup>

</Project>
