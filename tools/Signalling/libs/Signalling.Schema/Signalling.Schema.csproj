    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Signalling.Schema</RootNamespace>
    <AssemblyName>Signalling.Schema</AssemblyName>
    <Product>Signalling.Schema</Product>
    <Version>1.0.0</Version>
    <Company>Noël Danjou</Company>
